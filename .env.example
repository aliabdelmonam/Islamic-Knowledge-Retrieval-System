# ── API Keys ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# ── Qdrant ────────────────────────────────────────────────────────────────────
# For local Qdrant (docker or binary), leave QDRANT_URL blank and set host/port:
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud, set the full URL and API key:
# QDRANT_URL=https://xxx.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: gemini | groq | cohere
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.3-70b-versatile
COHERE_MODEL=command-a-03-2025

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=Omartificial-Intelligence-Space/Arabic-Triplet-Matryoshka-V2
EMBEDDING_BATCH_SIZE=256
# auto | cpu | cuda
EMBEDDING_DEVICE=auto
# Optional local cache directory. Missing models download automatically.
# HUGGINGFACE_CACHE_DIR=

# ── Paths ─────────────────────────────────────────────────────────────────────
# Defaults work automatically — override if needed
# DATA_CSV=data/semantic_clustered_hadiths_per_sharh.csv
# MODELS_DIR=models
# COLLECTION_NAME=hadith_rag

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false

# ── LangSmith (Agentic RAG tracing) ──────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=hadith-agentic-rag
