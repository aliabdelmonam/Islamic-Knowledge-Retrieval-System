# ── API Keys ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here
GOOGLE_API_KEY=your_google_api_key_here
SBG_API_KEY=your_sbg_api_key_here
FANAR_API_KEY=your_fanar_api_key_here

# ── Qdrant ────────────────────────────────────────────────────────────────────
# For local Qdrant (docker or binary), leave QDRANT_URL blank and set host/port:
QDRANT_HOST=localhost
QDRANT_PORT=6333
# For Qdrant Cloud, set the full URL and API key:
# QDRANT_URL=https://xxx.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: sbg | openai | groq | ollama | huggingface | huggingface_local | fanar
LLM_PROVIDER=sbg

# ── Paths ─────────────────────────────────────────────────────────────────────
# Defaults work automatically — override if needed
# DATA_CSV=data/semantic_clustered_hadiths_per_sharh.csv
# MODELS_DIR=models
# COLLECTION_NAME=hadith_rag

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false